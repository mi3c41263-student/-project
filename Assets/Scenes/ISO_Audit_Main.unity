  - "\u8CC7\u5B89\u4E3B\u7BA1\uFF1A\u300C\u4E86\u89E3\u3002\u9019\u662F\u4F60\u7684\u7A3D\u6838\u901A\u884C\u8B49\uFF0C\u9084\u6709\u4F60\u7533\u8ACB\u7684\u6E2C\u8A66\u7528\u786C\u789F\u3002\u4F7F\u7528\u7684\u6642\u5019\u9EBB\u7169\u5C0F\u5FC3\u4E00\u9EDE\uFF0C\u4E0D\u8981\u5F71\u97FF\u5230\u7CFB\u7D71\u904B\u4F5C\u3002\u300D"
  - "\u7A3D\u6838\u54E1\uFF08\u4F60\uFF09\uFF1A\u300C\u6C92\u554F\u984C\u3002\u9019\u6B21\u53EA\u662F\u505A\u8A98\u6355\u6E2C\u8A66\uFF0C\u6211\u6703\u67E5\u770B\u54E1\u5DE5\u662F\u5426\u96A8\u624B\u64BF\u8D77\u4E0D\u660E\u786C\u789F\uFF0C\u7136\u5F8C\u63D2\u5230\u96FB\u8166\u4E0A\u3002\u300D"
  dialogueClips:
  - {fileID: 8300000, guid: 0bf12c891e0c8c5418d007cf0fa4c1d1, type: 3}
  - {fileID: 8300000, guid: caa0197e6d581c94b895a93dcc12fcec, type: 3}
  - {fileID: 8300000, guid: f54299b6ecd43664ea52e85a7b1b5e28, type: 3}
  - {fileID: 8300000, guid: e0c7e21b07487da4c85eac2e1deb0c59, type: 3}
  secondStationDialogueLines:
  - "\u8CC7\u5B89\u4E3B\u7BA1\uFF1A\u300C\u7D50\u675F\u4E86\u555F\u52D5\u6703\u8B70\uFF0C\u6211\u60F3\u4F60\u61C9\u8A72\u4E5F\u611F\u89BA\u5F97\u5230\uFF0C\u6211\u5011\u516C\u53F8\u4E00\u76F4\u5F88\u91CD\u8996\u8CC7\u8A0A\u5B89\u5168\u3002\u300D"
  - "\u7A3D\u6838\u54E1\uFF08\u4F60\uFF09\uFF1A\u300C\u8CC7\u5B89\u4E3B\u7BA1\u60A8\u597D\u3002\u95DC\u65BC\u8CC7\u8A0A\u5B89\u5168\u610F\u8B58\u3001\u6559\u80B2\u8207\u8A13\u7DF4\uFF0C\u6211\u60F3\u4E86\u89E3\u4E00\u4E0B\uFF0C\u516C\u53F8\u600E\u9EBC\u78BA\u8A8D\u54E1\u5DE5\u4E0D\u662F\u53EA\u6709\u4E0A\u5B8C\u8AB2\uFF0C\u800C\u662F\u771F\u7684\u7406\u89E3\u8CC7\u5B89\u653F\u7B56\uFF1F\u300D"
  - "\u8CC7\u5B89\u4E3B\u7BA1\uFF1A\u300C\u6211\u5011\u6BCF\u5B63\u90FD\u6703\u5B89\u6392\u8CC7\u5B89\u8B1B\u7FD2\uFF0C\u8AB2\u5F8C\u4E5F\u6703\u6709\u7DDA\u4E0A\u6E2C\u9A57\u3002\u5982\u679C\u6E2C\u9A57\u6C92\u901A\u904E\uFF0C\u7CFB\u7D71\u6703\u66AB\u6642\u9650\u5236\u90E8\u5206\u6B0A\u9650\uFF0C\u76F4\u5230\u88DC\u8A13\u5B8C\u6210\u3002\u300D"
  - "\u7A3D\u6838\u54E1\uFF08\u4F60\uFF09\uFF1A\u300C\u4E86\u89E3\u3002\u90A3\u95DC\u65BC\u61F2\u6212\u7A0B\u5E8F\uFF0C\u5982\u679C\u54E1\u5DE5\u5728\u5BE6\u5730\u6E2C\u8A66\u4E2D\u6709\u56B4\u91CD\u9055\u898F\uFF0C\u4F8B\u5982\u628A\u4F86\u8DEF\u4E0D\u660E\u7684\u786C\u789F\u63D2\u9032\u516C\u53F8\u5167\u7DB2\uFF0C\u516C\u53F8\u904E\u53BB\u6709\u76F8\u95DC\u7684\u8655\u7406\u7D00\u9304\u55CE\uFF1F\u300D"
