  delayAfterEachLine: 0.5
  dialogueLines:
  - "\u8CC7\u5B89\u4E3B\u7BA1\uFF1A\u300C\u65E9\u5B89\u3002\u96D6\u7136\u5E74\u5EA6\u7A3D\u6838\u662F\u4F8B\u884C\u4F5C\u696D\uFF0C\u4E0D\u904E\u6211\u5011\u9084\u662F\u7167\u6D41\u7A0B\u4F86\u3002\u4F60\u7BC4\u570D\u90FD\u78BA\u8A8D\u597D\u4E86\u55CE\uFF1F\u300D"
  - "\u7A3D\u6838\u54E1\uFF08\u4F60\uFF09\uFF1A\u300C\u78BA\u8A8D\u5B8C\u7562\u3002\u4ECA\u5929\u6211\u5011\u4E3B\u8981\u6703\u91DD\u5C0D\u4EBA\u54E1\u63A7\u5236\u7684\u98A8\u96AA\u8A55\u4F30\uFF0C\u4EE5\u53CA\u5BE6\u9AD4\u63A7\u5236\u4E2D\u7684\u8CC7\u6E90\u7BA1\u7406\u8207\u4EBA\u54E1\u8CC7\u5B89\u610F\u8B58\u9032\u884C\u5BE9\u67E5\u3002\u6211\u5DF2\u7D93\u5C07\u4ECA\u65E5\u7BC4\u570D\u7684\u76F8\u95DC\u689D\u6587\u5C0D\u9F4A\u4E26\u986F\u793A\u5728\u7B46\u96FB\u4E0A\uFF0C\u96A8\u6642\u53EF\u4EE5\u9032\u884C\u6BD4\u5C0D\u8207\u67E5\u95B1\u3002\u300D"
  - "\u8CC7\u5B89\u4E3B\u7BA1\uFF1A\u300C\u4E86\u89E3\u3002\u9019\u662F\u4F60\u7684\u7A3D\u6838\u901A\u884C\u8B49\uFF0C\u9084\u6709\u4F60\u7533\u8ACB\u7684\u6E2C\u8A66\u7528\u786C\u789F\u3002\u4F7F\u7528\u7684\u6642\u5019\u9EBB\u7169\u5C0F\u5FC3\u4E00\u9EDE\uFF0C\u4E0D\u8981\u5F71\u97FF\u5230\u7CFB\u7D71\u904B\u4F5C\u3002\u300D"
  - "\u7A3D\u6838\u54E1\uFF08\u4F60\uFF09\uFF1A\u300C\u6C92\u554F\u984C\u3002\u9019\u6B21\u53EA\u662F\u505A\u8A98\u6355\u6E2C\u8A66\uFF0C\u6211\u6703\u67E5\u770B\u54E1\u5DE5\u662F\u5426\u96A8\u624B\u64BF\u8D77\u4E0D\u660E\u786C\u789F\uFF0C\u7136\u5F8C\u63D2\u5230\u96FB\u8166\u4E0A\u3002\u300D"
